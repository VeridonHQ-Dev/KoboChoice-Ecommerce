# ==============================================================================
# Kobo Choice - Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Application Settings
BASE_URL=/myweb/kobostoresecommerce
ADMIN_PATH=/myweb/kobostoresecommerce/admin
SITE_URL=http://localhost/myweb/kobostoresecommerce
SITE_NAME="Kobo Choice"
CURRENCY=USD
CURRENCY_SYMBOL=$
APP_TIMEZONE=Africa/Lagos

# Database Credentials
DB_HOST=localhost
DB_NAME=kobo_stores
DB_USER=root
DB_PASS=

# Paystack (Payment Gateway)
# Obtain keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_CURRENCY=NGN

# Google OAuth (Sign in with Google - Optional)
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost/myweb/kobostoresecommerce/auth/google-callback.php

# SMTP Mail Settings (Password reset & notifications)
# For Gmail, create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Kobo Choice"

# DKIM & Deliverability (Optional)
MAIL_DKIM_DOMAIN=
MAIL_DKIM_PRIVATE_KEY=
MAIL_DKIM_SELECTOR=default
MAIL_DKIM_PASSPHRASE=
MAIL_DKIM_IDENTITY=
