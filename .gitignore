# ==============================================================================
# Git Ignore Configuration - Kobo Choice E-Commerce
# ==============================================================================

# Environment & Sensitive Credentials
.env
.env.backup
.env.local
.env.*.local

# Dependency Directories
/vendor/
/node_modules/

# User Uploaded Files (Keep directory structure & placeholders)
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep
/public/uploads/categories/*
!/public/uploads/categories/.gitkeep
!/public/uploads/categories/placeholder.*
/public/uploads/cms/*
!/public/uploads/cms/.gitkeep
/public/uploads/customers/*
!/public/uploads/customers/.gitkeep
/public/uploads/products/*
!/public/uploads/products/.gitkeep
!/public/uploads/products/placeholder.*

# Log & Debug Files
*.log
error_log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.claude/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Backup & Temporary Files
*.bak*
*.tmp
*.swp
*~
